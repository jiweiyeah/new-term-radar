# Copy to .env beside config.json. .env is ignored by Git.
# Exported environment variables take precedence, including empty values.

# Notifications: a configured webhook automatically pushes daily/sources reports to Feishu.
FEISHU_WEBHOOK=
# Optional email: use --mail; all three settings are required.
RESEND_API_KEY=
EMAIL_FROM=
RADAR_EMAIL_TO=

# Data source keys. A missing key turns its own signal off, the rest keep working.
# Monid: the paid readings (X posts, Reddit, YouTube, Google Trends, whois, the page-one check).
MONID_API_KEY=
# The model gateway: every model call goes here (the name judge, the use cases, the pains, the sellers).
# An OpenAI-compatible API: the openai SDK is used when it is installed, the standard library otherwise.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.y-api.bestvirtualgoods.com/v1
# AIsa: optional, the second door for Google's own numbers, and the one that answers when Monid's does not.
AISA_API_KEY=
# TrustMRR: the weekly revenue signal. The key comes from TrustMRR's developer dashboard.
TRUSTMRR_API_KEY=
# GitHub: the breakout signal. Anonymous is 60 calls an hour, a token is 5000 (more calls, same results).
GITHUB_TOKEN=
# Search Console: for CI. Locally the radar reads gsc_token.json beside config.json.
GSC_TOKEN_JSON=
